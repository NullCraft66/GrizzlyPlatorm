@page "/device-pairing"
@inject HttpClient Api

<PageTitle>Pair Devices</PageTitle>

<div class="pairing-page">
    <div class="pairing-hero">
        <div>
            <div class="eyebrow">DEVICE SETUP</div>
            <h1>Pair scouting devices</h1>
            <p>@(pairing?.LocalNetwork == false
                    ? "Connect tablets using the hosted HTTPS address, even when they are on a different network."
                    : "Connect tablets to this host without typing an IP address. Keep the host and tablets on the same private Wi-Fi network.")</p>
        </div>
        <div class="pairing-status"><span class="status-dot"></span> Host ready</div>
    </div>

    @if (pairing is null)
    {
        <div class="pairing-loading">Loading pairing information...</div>
    }
    else
    {
        <div class="pairing-grid">
            <section class="pairing-card pairing-primary-card">
                <div class="card-kicker">RECOMMENDED</div>
                <h2>Scan with GrizzlyScout</h2>
                <p class="card-description">In the app, choose <strong>Scan Pairing QR</strong>. The tablet will save this host and reconnect automatically when its IP changes.</p>
                <div class="qr-frame"><img alt="GrizzlyScout pairing QR code" src="https://quickchart.io/qr?size=420&margin=4&ecLevel=M&text=@Uri.EscapeDataString(pairing.Qr)" /></div>
                <div class="host-name">@pairing.Name</div>
                <div class="host-id">Host ID: @pairing.Id</div>
            </section>

            <section class="pairing-card">
                <div class="card-kicker">BACKUP METHOD</div>
                <h2>Plain address QR</h2>
                <p class="card-description">Use this if a phone camera does not recognize the GrizzlyScout pairing link. It contains only the API address.</p>
                <div class="qr-frame qr-frame-small"><img alt="Plain API address QR code" src="https://quickchart.io/qr?size=360&margin=4&ecLevel=M&text=@Uri.EscapeDataString(pairing.Address)" /></div>
                <code class="address-box">@pairing.Address</code>
            </section>
        </div>

        <section class="connection-details">
            <h2>Connection details</h2>
            <div class="details-grid">
                @if (pairing.LocalNetwork)
                {
                    <div><span>Local host name</span><strong>@pairing.Mdns</strong></div>
                    <div><span>API port</span><strong>TCP 5263</strong></div>
                    <div><span>Discovery</span><strong>UDP 5264 + mDNS</strong></div>
                }
                else
                {
                    <div><span>Connection</span><strong>Hosted API</strong></div>
                    <div><span>Transport</span><strong>HTTPS</strong></div>
                    <div><span>Address</span><strong>@pairing.Address</strong></div>
                }
            </div>
        </section>

        <div class="pairing-help">
            <strong>Having trouble?</strong>
            @if (pairing.LocalNetwork)
            {
                <span>Make sure Windows Firewall allows TCP 5263 and UDP 5264, and that the network does not isolate connected devices.</span>
            }
            else
            {
                <span>Check that the hosted API address is configured and the device has internet access.</span>
            }
        </div>
    }
</div>

@code {
    private PairingInfo? pairing;
    protected override async Task OnInitializedAsync() => pairing = await Api.GetFromJsonAsync<PairingInfo>("api/discovery/pairing");
    private sealed record PairingInfo(string Name, string Id, string Address, string Mdns, string Qr, bool LocalNetwork = true);
}
