@page "/submissions"
@using System.Net.Http.Json
@using GrizzlyPlatform.Web.Models
@inject HttpClient Http

<PageTitle>Scouting Submissions</PageTitle>

<h1>Scouting Submissions</h1>

<div class="submissions-toolbar">

    <div class="season-filter">

        <button class="@GetSeasonButtonClass(0)"
                @onclick="ShowAllSeasons">
            All Seasons
        </button>

        @foreach (var season in seasons)
        {
            <button class="@GetSeasonButtonClass(season.Id)"
                    @onclick="() => SelectSeason(season.Id)">
                @season.Name
            </button>
        }

    </div>

    <div class="event-filter">

        <label for="eventFilter">
            Event:
        </label>

        <select id="eventFilter"
                class="form-select"
                value="@selectedEventId"
                @onchange="EventChanged">

            <option value="0">
                All Events
            </option>

            @foreach (var eventItem in EventsForSelectedSeason)
            {
                <option value="@eventItem.Id">
                    @eventItem.Name
                </option>
            }

        </select>

    </div>

    <div class="btn-group"
         role="group">

        <button class="@GetFilterButtonClass("All")"
                @onclick="ShowAll">
            All
        </button>

        <button class="@GetFilterButtonClass("Pit")"
                @onclick="ShowPit">
            Pit
        </button>

        <button class="@GetFilterButtonClass("Match")"
                @onclick="ShowMatch">
            Match
        </button>

    </div>

    <button class="btn btn-primary"
            @onclick="LoadData">
        Refresh
    </button>

</div>

@if (isLoading)
{
    <p>Loading submissions...</p>
}
else if (FilteredSubmissions.Count == 0)
{
    <p>No scouting submissions have been found.</p>
}
else
{
    @foreach (var submission in FilteredSubmissions)
    {
        <div class="submission-card">

            <div class="submission-header">

                <div>

                    <h3>
                        Submission #@submission.Id
                    </h3>

                    <span class="badge bg-primary">
                        Team @submission.TeamNumber
                    </span>
<span class="badge bg-secondary">
    @GetFormName(submission.GameFormId)
</span>

                    @if (IsPitSubmission(submission))
                    {
                        <span class="badge bg-success">
                            Pit
                        </span>
                    }
                    else if (IsMatchSubmission(submission))
                    {
                        <span class="badge bg-warning text-dark">
                            Match
                        </span>
                    }

                </div>

                <div class="submission-date">
                    @submission.CreatedAt
                </div>

            </div>

            <p>
                <strong>Scout:</strong>
                @submission.ScoutName
            </p>

        @if (submission.EventId.HasValue)
{
    <p>
        <strong>Event:</strong>
        @GetEventName(submission.EventId.Value)
    </p>
}

            @if (!string.IsNullOrWhiteSpace(submission.MatchType))
            {
                <p>
                    <strong>Match:</strong>
                    @submission.MatchType
                    @submission.MatchNumber
                </p>
            }

<button class="btn btn-outline-primary mb-3"
        @onclick="() => StartEditing(submission)">
    Edit Submission
</button>

<h5>Answers</h5>

@if (isEditing && editingSubmission?.Id == submission.Id)
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Question</th>
                <th>Answer</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var answer in submission.Answers)
            {
                <tr>
                    <td>
                    @GetFieldQuestion(
    submission.GameFormId,
    answer.GameFormFieldId)
                    </td>

                  <td>
    @RenderAnswerEditor(
        submission.GameFormId,
        answer.GameFormFieldId)
</td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-success"
            @onclick="SaveEditing">
        Save Changes
    </button>

    <button class="btn btn-secondary ms-2"
            @onclick="CancelEditing">
        Cancel
    </button>
}
else if (submission.Answers == null ||
         submission.Answers.Count == 0)
{
    <p>No answers found.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Question</th>
                <th>Answer</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var answer in submission.Answers)
            {
                <tr>
                    <td>
                       @GetFieldQuestion(
    submission.GameFormId,
    answer.GameFormFieldId)
                    </td>

                    <td>
                        @answer.Value
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
      </div>
    }
}

@code {

    private List<SubmissionModel> submissions = new();

    private List<SeasonModel> seasons = new();

    private List<EventModel> events = new();

    private List<GameFormModel> gameForms = new();

    private bool isLoading = true;

    private int selectedSeasonId = 0;

    private int selectedEventId = 0;

    private string selectedFilter = "All";

    private List<EventModel> EventsForSelectedSeason
    {
        get
        {
            if (selectedSeasonId == 0)
            {
                return events
                    .OrderBy(e => e.Name)
                    .ToList();
            }

            return events
                .Where(e =>
                    e.SeasonId == selectedSeasonId)
                .OrderBy(e => e.Name)
                .ToList();
        }
    }


private SubmissionModel? editingSubmission;

private Dictionary<int, string> editedAnswers = new();

private bool isEditing = false;

private void StartEditing(SubmissionModel submission)
{
    editingSubmission = submission;

    editedAnswers = new Dictionary<int, string>();

    foreach (var answer in submission.Answers)
    {
        editedAnswers[answer.GameFormFieldId] =
            answer.Value ?? string.Empty;
    }

    isEditing = true;
}

private string GetEditedAnswer(int fieldId)
{
    return editedAnswers.TryGetValue(
        fieldId,
        out var value)
        ? value
        : string.Empty;
}
private string GetFieldQuestion(
    int gameFormId,
    int fieldId)
{
    var form = gameForms.FirstOrDefault(
        f => f.Id == gameFormId);

    if (form == null)
    {
        return $"Field {fieldId}";
    }

    var field = form.Fields.FirstOrDefault(
        f => f.Id == fieldId);

    return field?.Question
        ?? $"Field {fieldId}";
}

private RenderFragment RenderAnswerEditor(int gameFormId, int fieldId)
{
    return builder =>
    {
        var form = gameForms.FirstOrDefault(f => f.Id == gameFormId);
        var field = form?.Fields.FirstOrDefault(f => f.Id == fieldId);

        if (field == null)
        {
            builder.AddContent(0, "Unknown field");
            return;
        }

        var value = GetEditedAnswer(fieldId);

        if (field.FieldType == 0)
        {
            // Text
            builder.OpenElement(1, "input");
            builder.AddAttribute(2, "class", "form-control");
            builder.AddAttribute(3, "value", value);
            builder.AddAttribute(
                4,
                "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => UpdateAnswer(
                        fieldId,
                        e.Value?.ToString() ?? string.Empty)));
            builder.CloseElement();
        }
        else if (field.FieldType == 1)
        {
            // Number
            builder.OpenElement(5, "input");
            builder.AddAttribute(6, "type", "number");
            builder.AddAttribute(7, "class", "form-control");
            builder.AddAttribute(8, "value", value);
            builder.AddAttribute(
                9,
                "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => UpdateAnswer(
                        fieldId,
                        e.Value?.ToString() ?? string.Empty)));
            builder.CloseElement();
        }
        else if (field.FieldType == 2)
        {
            // Yes / No
            builder.OpenElement(10, "select");
            builder.AddAttribute(11, "class", "form-select");
            builder.AddAttribute(12, "value", value);
            builder.AddAttribute(
                13,
                "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => UpdateAnswer(
                        fieldId,
                        e.Value?.ToString() ?? string.Empty)));

            builder.OpenElement(14, "option");
            builder.AddAttribute(15, "value", "");
            builder.AddContent(16, "Select...");
            builder.CloseElement();

            builder.OpenElement(17, "option");
            builder.AddAttribute(18, "value", "Yes");
            builder.AddContent(19, "Yes");
            builder.CloseElement();

            builder.OpenElement(20, "option");
            builder.AddAttribute(21, "value", "No");
            builder.AddContent(22, "No");
            builder.CloseElement();

            builder.CloseElement();
        }
        else if (field.FieldType == 3)
        {
            // Dropdown
            builder.OpenElement(23, "select");
            builder.AddAttribute(24, "class", "form-select");
            builder.AddAttribute(25, "value", value);
            builder.AddAttribute(
                26,
                "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => UpdateAnswer(
                        fieldId,
                        e.Value?.ToString() ?? string.Empty)));

            if (field.Options != null)
            {
                foreach (var option in field.Options)
                {
                    builder.OpenElement(27, "option");
                    builder.AddAttribute(28, "value", option.Value);
                    builder.AddContent(29, option.Value);
                    builder.CloseElement();
                }
            }

            builder.CloseElement();
        }
        else if (field.FieldType == 4)
        {
            // Checkbox
            var isChecked =
                value.Equals("true", StringComparison.OrdinalIgnoreCase) ||
                value.Equals("yes", StringComparison.OrdinalIgnoreCase);

            builder.OpenElement(30, "div");
            builder.AddAttribute(31, "class", "form-check");

            builder.OpenElement(32, "input");
            builder.AddAttribute(33, "type", "checkbox");
            builder.AddAttribute(34, "class", "form-check-input");
            builder.AddAttribute(35, "checked", isChecked);

            builder.AddAttribute(
                36,
                "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => UpdateAnswer(
                        fieldId,
                        (e.Value is bool checkedValue && checkedValue)
                            ? "true"
                            : "false")));

            builder.CloseElement();

            builder.OpenElement(37, "label");
            builder.AddAttribute(38, "class", "form-check-label");
            builder.AddContent(39, "Checked");
            builder.CloseElement();

            builder.CloseElement();
        }
        else if (field.FieldType == 5)
{
    // Multi-Select
    var selectedValues = value
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(v => v.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    builder.OpenElement(40, "div");
    builder.AddAttribute(41, "class", "multi-select-options");

    if (field.Options != null)
    {
        foreach (var option in field.Options)
        {
            var optionValue = option.Value;
            var isSelected = selectedValues.Contains(optionValue);

            builder.OpenElement(42, "div");
            builder.AddAttribute(43, "class", "form-check");

            builder.OpenElement(44, "input");
            builder.AddAttribute(45, "type", "checkbox");
            builder.AddAttribute(46, "class", "form-check-input");
            builder.AddAttribute(47, "checked", isSelected);

            builder.AddAttribute(
                48,
                "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e =>
                    {
                        var currentlyChecked =
                            e.Value is bool checkedValue && checkedValue;

                        if (currentlyChecked)
                        {
                            selectedValues.Add(optionValue);
                        }
                        else
                        {
                            selectedValues.Remove(optionValue);
                        }

                        UpdateAnswer(
                            fieldId,
                            string.Join(", ", selectedValues));
                    }));

            builder.CloseElement();

            builder.OpenElement(49, "label");
            builder.AddAttribute(50, "class", "form-check-label");
            builder.AddContent(51, optionValue);
            builder.CloseElement();

            builder.CloseElement();
        }
    }

    builder.CloseElement();
}
        else
        {
            // Fallback
            builder.OpenElement(40, "input");
            builder.AddAttribute(41, "class", "form-control");
            builder.AddAttribute(42, "value", value);
            builder.AddAttribute(
                43,
                "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => UpdateAnswer(
                        fieldId,
                        e.Value?.ToString() ?? string.Empty)));
            builder.CloseElement();
        }
    };
}
private void UpdateAnswer(
    int fieldId,
    string value)
{
    editedAnswers[fieldId] = value;
}

private void CancelEditing()
{
    editingSubmission = null;
    editedAnswers.Clear();
    isEditing = false;
}

private async Task SaveEditing()
{
    if (editingSubmission == null)
    {
        return;
    }

    var request = new
    {
        answers = editedAnswers
            .Select(answer => new
            {
                gameFormFieldId = answer.Key,
                value = answer.Value
            })
            .ToList()
    };

    var response = await Http.PutAsJsonAsync(
        $"api/GameFormSubmissions/{editingSubmission.Id}",
        request);

    if (!response.IsSuccessStatusCode)
    {
        var error =
            await response.Content.ReadAsStringAsync();

        Console.WriteLine(
            $"Failed to save submission: {error}");

        return;
    }

    CancelEditing();

    await LoadSubmissions();
}

    private List<SubmissionModel> SeasonSubmissions
    {
        get
        {
            IEnumerable<SubmissionModel> filtered = submissions;

            if (selectedSeasonId > 0)
            {
                var seasonFormIds = gameForms
                    .Where(form =>
                        form.SeasonId == selectedSeasonId)
                    .Select(form => form.Id)
                    .ToList();

                filtered = filtered.Where(submission =>
                    seasonFormIds.Contains(
                        submission.GameFormId));
            }

            if (selectedEventId > 0)
            {
                filtered = filtered.Where(submission =>
                    submission.EventId == selectedEventId);
            }

            return filtered.ToList();
        }
    }

    private List<SubmissionModel> FilteredSubmissions
    {
        get
        {
            if (selectedFilter == "Pit")
            {
                return SeasonSubmissions
                    .Where(IsPitSubmission)
                    .ToList();
            }

            if (selectedFilter == "Match")
            {
                return SeasonSubmissions
                    .Where(IsMatchSubmission)
                    .ToList();
            }

            return SeasonSubmissions;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            await LoadSeasons();
            await LoadEvents();
            await LoadGameForms();
            await LoadSubmissions();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSeasons()
    {
        seasons =
            await Http.GetFromJsonAsync<
                List<SeasonModel>
            >(
                "api/Seasons"
            )
            ?? new List<SeasonModel>();
    }

    private async Task LoadEvents()
    {
        events =
            await Http.GetFromJsonAsync<
                List<EventModel>
            >(
                "api/Events"
            )
            ?? new List<EventModel>();
    }

    private async Task LoadGameForms()
    {
        gameForms =
            await Http.GetFromJsonAsync<
                List<GameFormModel>
            >(
                "api/GameForms"
            )
            ?? new List<GameFormModel>();
    }

    private async Task LoadSubmissions()
    {
        submissions =
            await Http.GetFromJsonAsync<
                List<SubmissionModel>
            >(
                "api/GameFormSubmissions"
            )
            ?? new List<SubmissionModel>();
    }

    private void ShowAllSeasons()
    {
        selectedSeasonId = 0;
        selectedEventId = 0;
    }

    private void SelectSeason(int seasonId)
    {
        selectedSeasonId = seasonId;
        selectedEventId = 0;
    }

    private void EventChanged(ChangeEventArgs e)
    {
        selectedEventId =
            int.TryParse(
                e.Value?.ToString(),
                out var eventId)
            ? eventId
            : 0;
    }

    private void ShowAll()
    {
        SetFilter("All");
    }

    private void ShowPit()
    {
        SetFilter("Pit");
    }

    private void ShowMatch()
    {
        SetFilter("Match");
    }

    private void SetFilter(string filter)
    {
        selectedFilter = filter;
    }

    private bool IsPitSubmission(
        SubmissionModel submission)
    {
        var form = gameForms.FirstOrDefault(
            f => f.Id == submission.GameFormId);

        return form != null &&
            IsPitForm(form);
    }

    private bool IsMatchSubmission(
        SubmissionModel submission)
    {
        var form = gameForms.FirstOrDefault(
            f => f.Id == submission.GameFormId);

        return form != null &&
            IsMatchForm(form);
    }

private bool IsPitForm(GameFormModel form)
{
    return form.FormType == 0;
}

private bool IsMatchForm(GameFormModel form)
{
    return form.FormType == 1;
}
    private string GetSeasonButtonClass(int seasonId)
    {
        return selectedSeasonId == seasonId
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }

    private string GetFilterButtonClass(string filter)
    {
        return selectedFilter == filter
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }
    
    private string GetFormName(int formId)
{
    var form = gameForms.FirstOrDefault(f => f.Id == formId);
    return form?.Name ?? $"Form {formId}";
}
        private string GetEventName(int eventId)
{
    var eventItem =
        events.FirstOrDefault(
            e => e.Id == eventId);

    return eventItem?.Name
        ?? $"Event ID: {eventId}";
}
}