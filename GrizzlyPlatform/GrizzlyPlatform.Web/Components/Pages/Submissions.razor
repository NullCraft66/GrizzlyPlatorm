@page "/submissions"
@using System.Net.Http.Json
@using GrizzlyPlatform.Web.Models
@inject HttpClient Http

<PageTitle>Scouting Submissions</PageTitle>

<h1>Scouting Submissions</h1>

<div class="submissions-toolbar">

    <div class="season-filter">

        <button class="@GetSeasonButtonClass(0)"
                @onclick="ShowAllSeasons">
            All Seasons
        </button>

        @foreach (var season in seasons)
        {
            <button class="@GetSeasonButtonClass(season.Id)"
                    @onclick="() => SelectSeason(season.Id)">
                @season.Name
            </button>
        }

    </div>

    <div class="event-filter">

        <label for="eventFilter">
            Event:
        </label>

        <select id="eventFilter"
                class="form-select"
                value="@selectedEventId"
                @onchange="EventChanged">

            <option value="0">
                All Events
            </option>

            @foreach (var eventItem in EventsForSelectedSeason)
            {
                <option value="@eventItem.Id">
                    @eventItem.Name
                </option>
            }

        </select>

    </div>

    <div class="btn-group"
         role="group">

        <button class="@GetFilterButtonClass("All")"
                @onclick="ShowAll">
            All
        </button>

        <button class="@GetFilterButtonClass("Pit")"
                @onclick="ShowPit">
            Pit
        </button>

        <button class="@GetFilterButtonClass("Match")"
                @onclick="ShowMatch">
            Match
        </button>

    </div>

    <button class="btn btn-primary"
            @onclick="LoadData">
        Refresh
    </button>

</div>

@if (isLoading)
{
    <p>Loading submissions...</p>
}
else if (FilteredSubmissions.Count == 0)
{
    <p>No scouting submissions have been found.</p>
}
else
{
    @foreach (var submission in FilteredSubmissions)
    {
        <div class="submission-card">

            <div class="submission-header">

                <div>

                    <h3>
                        Submission #@submission.Id
                    </h3>

                    <span class="badge bg-primary">
                        Team @submission.TeamNumber
                    </span>

                    <span class="badge bg-secondary">
                        Form @submission.GameFormId
                    </span>

                    @if (IsPitSubmission(submission))
                    {
                        <span class="badge bg-success">
                            Pit
                        </span>
                    }
                    else if (IsMatchSubmission(submission))
                    {
                        <span class="badge bg-warning text-dark">
                            Match
                        </span>
                    }

                </div>

                <div class="submission-date">
                    @submission.CreatedAt
                </div>

            </div>

            <p>
                <strong>Scout:</strong>
                @submission.ScoutName
            </p>

        @if (submission.EventId.HasValue)
{
    <p>
        <strong>Event:</strong>
        @GetEventName(submission.EventId.Value)
    </p>
}

            @if (!string.IsNullOrWhiteSpace(submission.MatchType))
            {
                <p>
                    <strong>Match:</strong>
                    @submission.MatchType
                    @submission.MatchNumber
                </p>
            }

<button class="btn btn-outline-primary mb-3"
        @onclick="() => StartEditing(submission)">
    Edit Submission
</button>

<h5>Answers</h5>

@if (isEditing && editingSubmission?.Id == submission.Id)
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Field ID</th>
                <th>Answer</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var answer in submission.Answers)
            {
                <tr>
                    <td>
                        @answer.GameFormFieldId
                    </td>

                    <td>
                        <input class="form-control"
                               value="@GetEditedAnswer(answer.GameFormFieldId)"
                               @oninput="e => UpdateAnswer(
                                   answer.GameFormFieldId,
                                   e.Value?.ToString() ?? string.Empty)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-success"
            @onclick="SaveEditing">
        Save Changes
    </button>

    <button class="btn btn-secondary ms-2"
            @onclick="CancelEditing">
        Cancel
    </button>
}
else if (submission.Answers == null ||
         submission.Answers.Count == 0)
{
    <p>No answers found.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Field ID</th>
                <th>Answer</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var answer in submission.Answers)
            {
                <tr>
                    <td>
                        @answer.GameFormFieldId
                    </td>

                    <td>
                        @answer.Value
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
      </div>
    }
}

@code {

    private List<SubmissionModel> submissions = new();

    private List<SeasonModel> seasons = new();

    private List<EventModel> events = new();

    private List<GameFormModel> gameForms = new();

    private bool isLoading = true;

    private int selectedSeasonId = 0;

    private int selectedEventId = 0;

    private string selectedFilter = "All";

    private List<EventModel> EventsForSelectedSeason
    {
        get
        {
            if (selectedSeasonId == 0)
            {
                return events
                    .OrderBy(e => e.Name)
                    .ToList();
            }

            return events
                .Where(e =>
                    e.SeasonId == selectedSeasonId)
                .OrderBy(e => e.Name)
                .ToList();
        }
    }


private SubmissionModel? editingSubmission;

private Dictionary<int, string> editedAnswers = new();

private bool isEditing = false;

private void StartEditing(SubmissionModel submission)
{
    editingSubmission = submission;

    editedAnswers = new Dictionary<int, string>();

    foreach (var answer in submission.Answers)
    {
        editedAnswers[answer.GameFormFieldId] =
            answer.Value ?? string.Empty;
    }

    isEditing = true;
}

private string GetEditedAnswer(int fieldId)
{
    return editedAnswers.TryGetValue(
        fieldId,
        out var value)
        ? value
        : string.Empty;
}

private void UpdateAnswer(
    int fieldId,
    string value)
{
    editedAnswers[fieldId] = value;
}

private void CancelEditing()
{
    editingSubmission = null;
    editedAnswers.Clear();
    isEditing = false;
}

private async Task SaveEditing()
{
    if (editingSubmission == null)
    {
        return;
    }

    var request = new
    {
        answers = editedAnswers
            .Select(answer => new
            {
                gameFormFieldId = answer.Key,
                value = answer.Value
            })
            .ToList()
    };

    var response = await Http.PutAsJsonAsync(
        $"api/GameFormSubmissions/{editingSubmission.Id}",
        request);

    if (!response.IsSuccessStatusCode)
    {
        var error =
            await response.Content.ReadAsStringAsync();

        Console.WriteLine(
            $"Failed to save submission: {error}");

        return;
    }

    CancelEditing();

    await LoadSubmissions();
}

    private List<SubmissionModel> SeasonSubmissions
    {
        get
        {
            IEnumerable<SubmissionModel> filtered = submissions;

            if (selectedSeasonId > 0)
            {
                var seasonFormIds = gameForms
                    .Where(form =>
                        form.SeasonId == selectedSeasonId)
                    .Select(form => form.Id)
                    .ToList();

                filtered = filtered.Where(submission =>
                    seasonFormIds.Contains(
                        submission.GameFormId));
            }

            if (selectedEventId > 0)
            {
                filtered = filtered.Where(submission =>
                    submission.EventId == selectedEventId);
            }

            return filtered.ToList();
        }
    }

    private List<SubmissionModel> FilteredSubmissions
    {
        get
        {
            if (selectedFilter == "Pit")
            {
                return SeasonSubmissions
                    .Where(IsPitSubmission)
                    .ToList();
            }

            if (selectedFilter == "Match")
            {
                return SeasonSubmissions
                    .Where(IsMatchSubmission)
                    .ToList();
            }

            return SeasonSubmissions;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            await LoadSeasons();
            await LoadEvents();
            await LoadGameForms();
            await LoadSubmissions();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSeasons()
    {
        seasons =
            await Http.GetFromJsonAsync<
                List<SeasonModel>
            >(
                "api/Seasons"
            )
            ?? new List<SeasonModel>();
    }

    private async Task LoadEvents()
    {
        events =
            await Http.GetFromJsonAsync<
                List<EventModel>
            >(
                "api/Events"
            )
            ?? new List<EventModel>();
    }

    private async Task LoadGameForms()
    {
        gameForms =
            await Http.GetFromJsonAsync<
                List<GameFormModel>
            >(
                "api/GameForms"
            )
            ?? new List<GameFormModel>();
    }

    private async Task LoadSubmissions()
    {
        submissions =
            await Http.GetFromJsonAsync<
                List<SubmissionModel>
            >(
                "api/GameFormSubmissions"
            )
            ?? new List<SubmissionModel>();
    }

    private void ShowAllSeasons()
    {
        selectedSeasonId = 0;
        selectedEventId = 0;
    }

    private void SelectSeason(int seasonId)
    {
        selectedSeasonId = seasonId;
        selectedEventId = 0;
    }

    private void EventChanged(ChangeEventArgs e)
    {
        selectedEventId =
            int.TryParse(
                e.Value?.ToString(),
                out var eventId)
            ? eventId
            : 0;
    }

    private void ShowAll()
    {
        SetFilter("All");
    }

    private void ShowPit()
    {
        SetFilter("Pit");
    }

    private void ShowMatch()
    {
        SetFilter("Match");
    }

    private void SetFilter(string filter)
    {
        selectedFilter = filter;
    }

    private bool IsPitSubmission(
        SubmissionModel submission)
    {
        var form = gameForms.FirstOrDefault(
            f => f.Id == submission.GameFormId);

        return form != null &&
            IsPitForm(form);
    }

    private bool IsMatchSubmission(
        SubmissionModel submission)
    {
        var form = gameForms.FirstOrDefault(
            f => f.Id == submission.GameFormId);

        return form != null &&
            IsMatchForm(form);
    }

private bool IsPitForm(GameFormModel form)
{
    return form.FormType == 0;
}

private bool IsMatchForm(GameFormModel form)
{
    return form.FormType == 1;
}
    private string GetSeasonButtonClass(int seasonId)
    {
        return selectedSeasonId == seasonId
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }

    private string GetFilterButtonClass(string filter)
    {
        return selectedFilter == filter
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }
    private string GetEventName(int eventId)
{
    var eventItem =
        events.FirstOrDefault(
            e => e.Id == eventId);

    return eventItem?.Name
        ?? $"Event ID: {eventId}";
}
}