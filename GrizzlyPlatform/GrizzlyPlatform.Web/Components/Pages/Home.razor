@page "/"
@inject HttpClient Http

<PageTitle>GrizzlyPlatform</PageTitle>

<div class="grizzly-home">
    <header class="home-hero">
        <div class="home-logo-wrap">
            <img src="images/grizzly-logo.png" alt="Grizzly Robotics team emblem" class="home-logo" />
        </div>
        <h1>Grizzly Robotics</h1>
        <p class="home-tagline">Robotics scouting and event management platform</p>
    </header>

    @if (isLoading)
    {
        <p class="home-loading" role="status">Loading the live overview…</p>
    }
    else if (loadError is not null)
    {
        <section class="home-error-banner" role="alert" aria-labelledby="home-error-title">
            <span class="home-error-icon bi bi-exclamation-circle-fill" aria-hidden="true"></span>
            <div class="home-error-copy">
                <h2 id="home-error-title">Dashboard data unavailable</h2>
                <p>@loadError</p>
            </div>
            @if (loadErrorStatusCode is { } statusCode)
            {
                <span class="home-error-code">HTTP @((int)statusCode)</span>
            }
            <button type="button" class="dashboard-button" @onclick="LoadOverviewAsync">
                Retry
            </button>
        </section>
    }

    @if (events is not null && events.Any(IsCompetitionDay))
    {
        <div class="competition-message" role="status">Good luck at competition today, Grizzly Robotics!</div>
    }

    <section class="dashboard-grid" aria-label="Platform overview">

        <article class="dashboard-card">
            <h2>Events</h2>
            <p class="number event-count">@(events is null ? "—" : events.Count.ToString())</p>
            <NavLink class="dashboard-button" href="events">
                View Events
            </NavLink>
        </article>

        <article class="dashboard-card">
            <h2>Current Season</h2>

            @if (events is null)
            {
                <p class="dashboard-detail">Unavailable</p>
            }
            else if (events.Count > 0 && events[0].Season is not null)
            {
                <p class="number">@events[0].Season!.Name</p>
                <p class="dashboard-detail">@events[0].Season!.Year</p>
            }
            else
            {
                <p class="dashboard-detail">No season data</p>
            }
        </article>

        <article class="dashboard-card">
            <h2>Latest Event</h2>

            @if (events is null)
            {
                <p class="dashboard-detail">Unavailable</p>
            }
            else if (events.Count > 0)
            {
                <p class="number">@events[0].Name</p>
                <p class="dashboard-detail">@events[0].Location</p>
            }
            else
            {
                <p class="dashboard-detail">No events</p>
            }
        </article>

    </section>
</div>

@code {
    private List<EventModel>? events;
    private bool isLoading = true;
    private string? loadError;
    private System.Net.HttpStatusCode? loadErrorStatusCode;

    private static bool IsCompetitionDay(EventModel eventItem)
    {
        var today = DateTime.Today;
        return eventItem.StartDate.HasValue && eventItem.EndDate.HasValue
            && today >= eventItem.StartDate.Value.Date
            && today <= eventItem.EndDate.Value.Date;
    }

    protected override Task OnInitializedAsync() => LoadOverviewAsync();

    private async Task LoadOverviewAsync()
    {
        isLoading = true;
        loadError = null;
        loadErrorStatusCode = null;
        events = null;

        try
        {
            using var response = await Http.GetAsync("api/events");
            if (!response.IsSuccessStatusCode)
            {
                loadErrorStatusCode = response.StatusCode;
                loadError = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized => "Sign in to view event data, then try again.",
                    System.Net.HttpStatusCode.Forbidden => "Your account does not have permission to load event data.",
                    System.Net.HttpStatusCode.NotFound => "The events service is not available in this environment yet.",
                    System.Net.HttpStatusCode.ServiceUnavailable => "The scouting service is temporarily unavailable. Try again in a moment.",
                    System.Net.HttpStatusCode.InternalServerError => "The API responded, but could not load event data. Try again, or contact a platform administrator if this continues.",
                    _ => "The server responded, but the event overview could not be loaded. Try again or contact a platform administrator."
                };
                return;
            }

            events = await response.Content.ReadFromJsonAsync<List<EventModel>>() ?? new();
        }
        catch (HttpRequestException)
        {
            loadError = "Could not connect to the GrizzlyPlatform API. Check the connection and try again.";
        }
        catch (TaskCanceledException)
        {
            loadError = "The server took too long to respond. Try again.";
        }
        catch (System.Text.Json.JsonException)
        {
            loadError = "The server returned data the overview could not read. Try again, or contact an administrator if this continues.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class EventModel
    {
        public int Id { get; set; }
        public int SeasonId { get; set; }
        public string Name { get; set; } = "";
        public string Location { get; set; } = "";
        public string? BlueAllianceKey { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public SeasonModel? Season { get; set; }
    }

    public class SeasonModel
    {
        public int Id { get; set; }
        public int Year { get; set; }
        public string Name { get; set; } = "";
    }
}
