@page "/"
@inject HttpClient Http

<PageTitle>GrizzlyPlatform</PageTitle>

<div class="grizzly-home">
    <div class="home-logo-wrap"><img src="images/grizzly-logo.png" alt="Grizzly Robotics" class="home-logo" /></div><h1>Grizzly Robotics</h1>

    <p class="home-tagline">
        Robotics scouting and event management platform
    </p>

    @if (events == null)
    {
        <p>Loading...</p>
    }
    else
    {
        @if (events.Any(IsCompetitionDay))
    {
        <div class="competition-message">Good luck at competition today, Grizzly Robotics!</div>
    }

    <div class="dashboard-grid">

            <div class="dashboard-card">
                <h2>Events</h2>
                <p class="number">@events.Count</p>
                <NavLink class="dashboard-button" href="events">
                    View Events
                </NavLink>
            </div>

            <div class="dashboard-card">
                <h2>Current Season</h2>

                @if (events.Count > 0 && events[0].Season is not null)
                {
                    <p class="number">@events[0].Season!.Name</p>
                    <p>@events[0].Season!.Year</p>
                }
                else
                {
                    <p>No season data</p>
                }
            </div>

            <div class="dashboard-card">
                <h2>Latest Event</h2>

                @if (events.Count > 0)
                {
                    <p class="number">@events[0].Name</p>
                    <p>@events[0].Location</p>
                }
                else
                {
                    <p>No events</p>
                }
            </div>

        </div>
    }
</div>

@code {
    private List<EventModel>? events;

    private static bool IsCompetitionDay(EventModel eventItem)
    {
        var today = DateTime.Today;
        return eventItem.StartDate.HasValue && eventItem.EndDate.HasValue
            && today >= eventItem.StartDate.Value.Date
            && today <= eventItem.EndDate.Value.Date;
    }

    protected override async Task OnInitializedAsync()
    {
        events = await Http.GetFromJsonAsync<List<EventModel>>(
            "api/events");
    }

    public class EventModel
    {
        public int Id { get; set; }
        public int SeasonId { get; set; }
        public string Name { get; set; } = "";
        public string Location { get; set; } = "";
        public string? BlueAllianceKey { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public SeasonModel? Season { get; set; }
    }

    public class SeasonModel
    {
        public int Id { get; set; }
        public int Year { get; set; }
        public string Name { get; set; } = "";
    }
}




