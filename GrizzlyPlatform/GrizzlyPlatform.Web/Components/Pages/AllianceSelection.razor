@using System.Text.Json
@using GrizzlyPlatform.Web.Components.Shared
@page "/allianceselection"
@rendermode InteractiveServer
@using GrizzlyPlatform.Web.Models
@inject HttpClient Http
<PageTitle>Alliance Selection</PageTitle>

<h1>Alliance Selection</h1>
@if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
<button class="btn btn-secondary mb-3" disabled="@(loading || saving || planDirty)" @onclick="Reload">Refresh</button>
@if (selection?.Status == "InProgress")
{
    <div class="alert alert-info" role="status">
        Round @selection.CurrentRound: Alliance @selection.CurrentAlliance is inviting.
        Record whether the invited team accepted or declined.
    </div>
}

<div class="alliance-selection-page">

    <div class="selection-header">
        <div>
            <h2>Event</h2>

            <select disabled="@(loading || saving || planDirty)" @bind="selectedEventId"
                    @bind:after="EventChanged">
                <option value="0">Select an event</option>

                @foreach (var eventItem in events)
                {
                    <option value="@eventItem.Id">
                        @eventItem.Name
                    </option>
                }
            </select>
        </div>

        @if (selectedEventId > 0)
        {
            <div class="selection-status">
                <strong>Status:</strong>
                @(selection?.Status ?? "Not Started")
            </div>
        }
    </div>

    @if (selectedEventId == 0)
    {
        <div class="empty-state">
            <h2>Select an event</h2>
            <p>Choose an event to begin Alliance Selection.</p>
        </div>
    }
    else if (loading)
    {
        <p>Loading Alliance Selection...</p>
    }
    else
    {
        <AlliancePlanBoard @key="selectedEventId" EventId="selectedEventId" @ref="planBoard" DirtyChanged="value => planDirty = value" />
        <section class="top-eight-section">
            <div class="section-header">
                <div>
                    <h2>Top 8 Alliance Captains</h2>
                    <p>
                        These teams are the current alliance captains,
                        ranked 1 through 8.
                    </p>
                </div>

                @if (selection == null || selection.Status == "NotStarted")
                {
                    <button type="button"
                            @onclick="StartSelection"
                            disabled="@(topEight.Count != 8 || saving || loadFailed)">
                        Start Alliance Selection
                    </button>
                }
            </div>

            @if (topEight.Count == 0)
            {
                <div class="empty-state">
                    <p>No ranked teams are available for this event.</p>
                </div>
            }
            else
            {
                <div class="top-eight-grid">
                    @foreach (var team in topEight.OrderBy(t => t.Rank))
                    {
                        <div class="captain-card">
                            <div class="captain-rank">
                                @team.Rank
                            </div>

                            <div class="captain-team">
                                <strong>@team.TeamNumber</strong>
                                <span>@team.TeamName</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="team-selection-section">

            <div class="section-header">
                <div>
                    <h2>Available Teams</h2>
                    <p>
                        Search and filter teams using scouting information.
                    </p>
                </div>
            </div>

            <div class="filter-group mb-3">
                <label for="pit-filter-form">Pit form used for filters</label>
                <select id="pit-filter-form" disabled="@(loading || saving || planDirty)" @bind="selectedPitFormId" @bind:after="SetScoutingFields">
                    <option value="0">No pit form</option>
                    @foreach (var form in pitForms)
                    {
                        <option value="@form.Id">@form.Name</option>
                    }
                </select>
                <p>Only submissions from this event and the selected form are used.</p>
            </div>
            <div class="filters">

                <div class="filter-group">
                    <label>Search</label>

                    <input @bind="searchText"
                           @bind:event="oninput"
                           placeholder="Team number or name..." />
                </div>

                <div class="filter-group">
                    <label>Sort By</label>

                    <select @bind="sortOption">
                        <option value="Rank">Event Ranking</option>
                        <option value="TeamNumber">Team Number</option>
                        <option value="TeamName">Team Name</option>
                    </select>
                </div>

              <div class="filter-group">
    <label>Order</label>

    <select @bind="sortOrder">
        <option value="Best">Ascending</option>
        <option value="Worst">Descending</option>
    </select>
</div>
@foreach (var field in scoutingFields)
{
    if (!scoutingFilters.ContainsKey(field.Id))
    {
        scoutingFilters[field.Id] = "";
    }

    <div class="filter-group">
        <label>@field.Question</label>
        @if (field.FieldType == 2)
        {
            <select @bind="scoutingFilters[field.Id]">
                <option value="">Any</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>
        }
        else if (field.FieldType == 3)
        {
            <select @bind="scoutingFilters[field.Id]">
                <option value="">Any</option>

                @foreach (var option in field.Options)
                {
                    <option value="@option.Value">
                        @option.Value
                    </option>
                }
            </select>
        }
        else if (field.FieldType == 4)
        {
            <select @bind="scoutingFilters[field.Id]">
                <option value="">Any</option>
                <option value="true">Checked</option>
                <option value="false">Unchecked</option>
            </select>
        }

else if (field.FieldType == 1)
{
    <input type="number"
           placeholder="Minimum"
           @bind="scoutingFilters[field.Id]" />
}

        else if (field.FieldType == 5)
        {
            <select @bind="scoutingFilters[field.Id]">
                <option value="">Any</option>

                @foreach (var option in field.Options)
                {
                    <option value="@option.Value">
                        @option.Value
                    </option>
                }
            </select>
        }
    </div>
}

            </div>

            @if (!GetFilteredAndSortedTeams().Any())
            {
                <div class="empty-state">
                    <p>No teams match the current filters.</p>
                </div>
            }
            else
            {
                <div class="team-list">

                    @foreach (var team in GetFilteredAndSortedTeams())
                    {
                        <div class="team-row">

                            <div class="team-rank">
                                #@team.Rank
                            </div>

                            <div class="team-info">
                                <strong>@team.TeamNumber</strong>
                                <span>@team.TeamName</span>
                            </div>

                            <div class="team-actions">
                                <button type="button" disabled="@(planBoard?.IsLoaded != true)" @onclick="() => planBoard!.AddTeam(team.TeamId)">Add to wishlist</button>
                                @if (IsCaptain(team.TeamId))
                                {
                                    <span class="team-badge captain">Captain</span>
                                }
                                @if (IsSelected(team.TeamId))
                                {
                                    <span class="team-badge selected">Selected</span>
                                }
                                @if (HasDeclined(team.TeamId))
                                {
                                    <span class="team-badge">Declined</span>
                                }
                                @if (CanInvite(team.TeamId))
                                {
                                    <button type="button" disabled="@saving" @onclick="() => RecordInvitation(team, false)">Record acceptance</button>
                                    <button type="button" disabled="@saving" @onclick="() => RecordInvitation(team, true)">Record decline</button>
                                }
                            </div>

                        </div>
                    }

                </div>
            }

        </section>

        @if (selection != null)
        {
            @if (selection.Picks.Count > 0)
            {
                <details class="mb-3">
                    <summary>Invitation history (@selection.Picks.Count)</summary>
                    <ol>
                        @foreach (var pick in selection.Picks.OrderBy(p => p.PickOrder))
                        {
                            <li>Round @pick.Round, Alliance @pick.AllianceNumber invited @pick.InvitedTeamNumber: @pick.Result</li>
                        }
                    </ol>
                </details>
            }
            <section class="alliances-section">

                <div class="section-header">
                    <div>
                        <h2>Alliances</h2>
                        <p>
                            Current alliance selections.
                        </p>
                    </div>
                </div>

                <div class="alliances-grid">

                    @foreach (var alliance in selection.Alliances
                        .OrderBy(a => a.AllianceNumber))
                    {
                        <div class="alliance-card">

                            <div class="alliance-header">
                                <strong>
                                    Alliance @alliance.AllianceNumber
                                </strong>
                            </div>

                            <div class="alliance-captain">
                                <span>Captain</span>

                                <strong>
                                    @alliance.CaptainTeamNumber
                                    @if (!string.IsNullOrWhiteSpace(
                                        alliance.CaptainTeamName))
                                    {
                                        <span>
                                            - @alliance.CaptainTeamName
                                        </span>
                                    }
                                </strong>
                            </div>

                            @foreach (var member in alliance.Members
                                .OrderBy(m => m.SelectionOrder))
                            {
                                <div class="alliance-member">
                                    <span>
                                        Pick @member.SelectionOrder
                                    </span>

                                    <strong>
                                        @member.TeamNumber
                                        @if (!string.IsNullOrWhiteSpace(
                                            member.TeamName))
                                        {
                                            <span>
                                                - @member.TeamName
                                            </span>
                                        }
                                    </strong>
                                </div>
                            }

                        </div>
                    }

                </div>

            </section>
        }
    }

</div>

@code {
    private List<EventModel> events = new();
    private List<AllianceTeamModel> topEight = new();
    private List<AllianceTeamModel> filteredTeams = new();
    private AllianceSelectionModel? selection;
    private int selectedEventId;
    private string searchText = "";
    private string sortOption = "Rank";
    private string sortOrder = "Best";
    private bool loading;
    private bool planDirty;
    private AlliancePlanBoard? planBoard;
    private bool saving;
    private bool loadFailed;
    private string? errorMessage;
    private List<GameFormModel> pitForms = new();
    private int selectedPitFormId;
    private List<ScoutingFieldModel> scoutingFields = new();
    private List<ScoutingSubmissionModel> scoutingSubmissions = new();
    private Dictionary<int, string> scoutingFilters = new();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        if (saving || loading) return;
        loading = true;
        errorMessage = null;
        try { events = await Http.GetFromJsonAsync<List<EventModel>>("api/Events") ?? new(); }
        catch (Exception ex) { errorMessage = $"Could not load events: {ex.Message}"; }
        finally { loading = false; }
        if (errorMessage == null) await EventChanged();
    }

    private async Task EventChanged()
    {
        loading = true;
        loadFailed = false;
        errorMessage = null;
        topEight.Clear();
        filteredTeams.Clear();
        pitForms.Clear();
        scoutingFields.Clear();
        scoutingSubmissions.Clear();
        scoutingFilters.Clear();
        selectedPitFormId = 0;
        selection = null;
        try
        {
            if (selectedEventId <= 0) return;
            await LoadAllianceSelection();
            await LoadScoutingData();
        }
        catch (Exception ex)
        {
            loadFailed = true;
            errorMessage = $"Could not load alliance selection: {ex.Message}";
        }
        finally { loading = false; }
    }

    private async Task LoadAllianceSelection()
    {
        var result = await Http.GetFromJsonAsync<AllianceSelectionResponse>(
            $"api/AllianceSelection/event/{selectedEventId}");
        selection = result?.Exists == true ? result.Selection : null;
        var rankings = await Http.GetFromJsonAsync<List<EventRankingResponse>>(
            $"api/EventRankings/event/{selectedEventId}") ?? new();
        filteredTeams = rankings.OrderBy(r => r.Rank).Select(r => new AllianceTeamModel
        {
            TeamId = r.TeamId, TeamNumber = r.TeamNumber, TeamName = r.TeamName, Rank = r.Rank
        }).ToList();
        topEight = selection == null
            ? filteredTeams.Take(8).ToList()
            : selection.Alliances.OrderBy(a => a.AllianceNumber).Select(a => new AllianceTeamModel
            {
                TeamId = a.CaptainTeamId, TeamNumber = a.CaptainTeamNumber ?? 0,
                TeamName = a.CaptainTeamName ?? "", Rank = a.AllianceNumber
            }).ToList();
    }

    private async Task LoadScoutingData()
    {
        var eventItem = events.First(e => e.Id == selectedEventId);
        var forms = await Http.GetFromJsonAsync<List<GameFormModel>>("api/GameForms") ?? new();
        pitForms = forms.Where(f => f.FormType == 0 && f.SeasonId == eventItem.SeasonId)
            .OrderByDescending(f => f.Id).ToList();
        scoutingSubmissions = await Http.GetFromJsonAsync<List<ScoutingSubmissionModel>>(
            $"api/GameFormSubmissions/event/{selectedEventId}") ?? new();
        var active = await Http.GetFromJsonAsync<ActiveConfiguration>("api/ActiveScoutingConfiguration");
        selectedPitFormId = pitForms.FirstOrDefault(f => f.Id == active?.ActivePitFormId)?.Id
            ?? pitForms.FirstOrDefault(f => scoutingSubmissions.Any(s =>
                s.EventId == selectedEventId && s.GameFormId == f.Id))?.Id
            ?? pitForms.FirstOrDefault()?.Id ?? 0;
        SetScoutingFields();
    }

    private void SetScoutingFields()
    {
        scoutingFilters.Clear();
        scoutingFields = pitForms.FirstOrDefault(f => f.Id == selectedPitFormId)?.Fields
            .Where(f => !f.IsSystemField && f.FieldType >= 1 && f.FieldType <= 5)
            .OrderBy(f => f.DisplayOrder).Select(f => new ScoutingFieldModel
            {
                Id = f.Id, Question = f.Question, FieldType = f.FieldType,
                Options = f.Options.Select(o => new ScoutingOptionModel { Id = o.Id, Value = o.Value }).ToList()
            }).ToList() ?? new();
        foreach (var field in scoutingFields) scoutingFilters[field.Id] = "";
    }

    private IEnumerable<AllianceTeamModel> GetFilteredAndSortedTeams()
    {
        IEnumerable<AllianceTeamModel> result = filteredTeams;
        if (!string.IsNullOrWhiteSpace(searchText))
            result = result.Where(t => t.TeamNumber.ToString().Contains(searchText.Trim()) ||
                t.TeamName.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase));
        foreach (var filter in scoutingFilters.Where(f => !string.IsNullOrWhiteSpace(f.Value)))
            result = result.Where(t => TeamMatchesScoutingFilter(t.TeamId, filter.Key, filter.Value));
        result = sortOption switch
        {
            "TeamNumber" => result.OrderBy(t => t.TeamNumber),
            "TeamName" => result.OrderBy(t => t.TeamName),
            _ => result.OrderBy(t => t.Rank)
        };
        return sortOrder == "Worst" ? result.Reverse() : result;
    }

    private bool TeamMatchesScoutingFilter(int teamId, int fieldId, string value)
    {
        var submission = scoutingSubmissions
            .Where(s => s.TeamId == teamId && s.EventId == selectedEventId && s.GameFormId == selectedPitFormId)
            .OrderByDescending(s => s.SubmittedAt).ThenByDescending(s => s.Id).FirstOrDefault();
        var answer = submission?.Answers.FirstOrDefault(a => a.FieldId == fieldId);
        var field = scoutingFields.First(f => f.Id == fieldId);
        return GrizzlyPlatform.Web.Services.ScoutingAnswerFilter.Matches(field.FieldType, answer?.Value, value);
    }

    private bool IsSelected(int teamId) =>
        selection?.Alliances.SelectMany(a => a.Members).Any(m => m.TeamId == teamId) == true;
    private bool HasDeclined(int teamId) =>
        selection?.Picks.Any(p => p.InvitedTeamId == teamId && p.Result == "Declined") == true;
    private bool CanInvite(int teamId)
    {
        if (loadFailed || selection?.Status != "InProgress" || IsSelected(teamId) || HasDeclined(teamId))
            return false;
        var captain = selection.Alliances.FirstOrDefault(a => a.CaptainTeamId == teamId);
        return captain == null || (selection.CurrentRound == 1 &&
            captain.AllianceNumber > selection.CurrentAlliance && captain.Members.Count == 0);
    }

    private async Task StartSelection()
    {
        if (saving || loadFailed || topEight.Count != 8 || selection != null) return;
        await SaveAction("start", new StartAllianceSelectionRequest
        {
            EventId = selectedEventId,
            TeamIds = topEight.OrderBy(t => t.Rank).Select(t => t.TeamId).ToList(),
            RankedTeamIds = filteredTeams.OrderBy(t => t.Rank).Select(t => t.TeamId).ToList()
        });
    }

    private async Task RecordInvitation(AllianceTeamModel team, bool declined)
    {
        if (saving || !CanInvite(team.TeamId) || selection == null) return;
        await SaveAction(declined ? "decline" : "pick", new PickAllianceTeamRequest
        {
            AllianceSelectionId = selection.Id, AllianceNumber = selection.CurrentAlliance,
            ExpectedRound = selection.CurrentRound, ExpectedPickCount = selection.Picks.Count,
            TeamId = team.TeamId
        });
    }

    private async Task SaveAction<T>(string action, T request)
    {
        saving = true;
        errorMessage = null;
        try
        {
            using var response = await Http.PostAsJsonAsync($"api/AllianceSelection/{action}", request);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                await LoadAllianceSelection();
                return;
            }
            await LoadAllianceSelection();
        }
        catch (Exception ex)
        {
            loadFailed = true;
            errorMessage = $"Could not finish the action. Refresh to check the saved draft before trying again. {ex.Message}";
        }
        finally { saving = false; }
    }
    private class AllianceTeamModel
    {
        public int TeamId { get; set; }
        public int TeamNumber { get; set; }
        public string TeamName { get; set; } = "";
        public int Rank { get; set; }
    }

    private class AllianceSelectionResponse
    {
        public bool Exists { get; set; }
        public int EventId { get; set; }
        public int Id { get; set; }
        public string Status { get; set; } = "";
        public int CurrentRound { get; set; }
        public int CurrentAlliance { get; set; }
        public AllianceSelectionModel? Selection { get; set; }
    }

    private class AllianceSelectionModel
    {
        public int Id { get; set; }
        public int EventId { get; set; }
        public string Status { get; set; } = "";
        public int CurrentRound { get; set; }
        public int CurrentAlliance { get; set; }
        public List<AllianceModel> Alliances { get; set; } = new();
        public List<AlliancePickModel> Picks { get; set; } = new();
    }

    private class AlliancePickModel
    {
        public int PickOrder { get; set; }
        public int Round { get; set; }
        public int AllianceNumber { get; set; }
        public int InvitedTeamId { get; set; }
        public int? InvitedTeamNumber { get; set; }
        public string Result { get; set; } = "";
    }
    private class ActiveConfiguration
    {
        public int? ActivePitFormId { get; set; }
    }
    private class AllianceModel
    {
        public int Id { get; set; }
        public int AllianceNumber { get; set; }
        public int CaptainTeamId { get; set; }
        public int? CaptainTeamNumber { get; set; }
        public string? CaptainTeamName { get; set; }
        public List<AllianceMemberModel> Members { get; set; } = new();
    }

    private class AllianceMemberModel
    {
        public int TeamId { get; set; }
        public int? TeamNumber { get; set; }
        public string? TeamName { get; set; }
        public int SelectionRound { get; set; }
        public int SelectionOrder { get; set; }
    }

private class EventTeamsResponse
{
    public List<EventTeamResponse> Value { get; set; } = new();
    public int Count { get; set; }
}

private class EventTeamResponse
{
    public int Id { get; set; }
    public int EventId { get; set; }
    public int TeamId { get; set; }
    public EventTeamTeamResponse? Team { get; set; }
}

private class EventTeamTeamResponse
{
    public int Id { get; set; }
    public int TeamNumber { get; set; }
    public string Name { get; set; } = "";
}

private class ScoutingFieldModel
{
    public int Id { get; set; }
    public string Question { get; set; } = "";
    public int FieldType { get; set; }
    public List<ScoutingOptionModel> Options { get; set; } = new();
}

private class ScoutingOptionModel
{
    public int Id { get; set; }
    public string Value { get; set; } = "";
}

private class ScoutingSubmissionModel
{
    public int Id { get; set; }    public int GameFormId { get; set; }
    public string? GameFormName { get; set; }
    public string? FormType { get; set; }

    public int? EventId { get; set; }
    public int? MatchId { get; set; }
    public int? MatchNumber { get; set; }

    public int TeamId { get; set; }
    public int? TeamNumber { get; set; }
    public string? TeamName { get; set; }

    public DateTime SubmittedAt { get; set; }

    public List<ScoutingAnswerModel> Answers { get; set; } = new();
}
private bool IsCaptain(int teamId)
{
    return topEight.Any(team => team.TeamId == teamId);
}
private class ScoutingAnswerModel
{
    public int FieldId { get; set; }
    public string? Question { get; set; }
    public string Value { get; set; } = "";
}

    private class StartAllianceSelectionRequest
    {
        public int EventId { get; set; }
        public List<int> TeamIds { get; set; } = new();
        public List<int> RankedTeamIds { get; set; } = new();
    }

    private class PickAllianceTeamRequest
    {
        public int AllianceSelectionId { get; set; }
        public int ExpectedRound { get; set; }
        public int ExpectedPickCount { get; set; }
        public int AllianceNumber { get; set; }
        public int TeamId { get; set; }
    }
        
    private class EventRankingResponse
    {
        public int Id { get; set; }
        public int EventId { get; set; }
        public int TeamId { get; set; }
        public int TeamNumber { get; set; }
        public string TeamName { get; set; } = "";
        public int Rank { get; set; }
        public int RankingPoints { get; set; }
        public double? TieBreaker1 { get; set; }
        public double? TieBreaker2 { get; set; }
    }

    private class EventRankingsResponse
    {
        public List<EventRankingResponse> Value { get; set; } = new();
        public int Count { get; set; }
    }











}
