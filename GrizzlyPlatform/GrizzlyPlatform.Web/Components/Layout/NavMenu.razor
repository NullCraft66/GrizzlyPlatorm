@inject GrizzlyPlatform.Web.Services.AuthState AuthState
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand grizzly-brand" href="">
    <img class="brand-image-slot" src="@(AuthState.IsKimTheme ? "images/kim-screensaver.png" : "images/kiwi-bear.png")" alt="@(AuthState.IsKimTheme ? "Dr. Kim theme image" : "Kiwi bear mascot")" />
    <span>GrizzlyPlatform</span>
</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column" aria-label="Platform pages" @onclick="OnNavigate">

  @if (AuthState.IsLoggedIn)
{
    <div class="nav-item px-3">
        <div class="account-card">
            <div class="account-name">
                @AuthState.DisplayName
            </div>

            <div class="account-role">
                role:
                <span class="user-role @AuthState.Role.ToLowerInvariant()">
                    @AuthState.Role
                </span>
            </div>

            <div class="account-message">
                enjoy your stay
            </div>

            <button class="btn btn-outline-light w-100 account-logout"
                    @onclick="Logout">
                Logout
            </button>
        </div>
    </div>
}
else
{
    <div class="nav-item px-3">
        <div class="account-card guest-account-card">
            <div class="account-name">Guest</div>
            <div class="account-role">Sign in to access scouting tools</div>
            <div class="account-message">welcome to GrizzlyPlatform</div>
            <NavLink class="btn btn-outline-light w-100 account-login" href="login">
                <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Login
            </NavLink>
        </div>
    </div>
}


        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill"
                      aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="seasons">
                <span class="bi bi-calendar-range"
                      aria-hidden="true"></span> Seasons
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="events">
                <span class="bi bi-calendar-event"
                      aria-hidden="true"></span> Events
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="event-operations">
                <span class="bi bi-list-ol"
                      aria-hidden="true"></span> Event Operations
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="gameforms">
                <span class="bi bi-ui-checks"
                      aria-hidden="true"></span> Game Forms
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="device-pairing"><span class="bi bi-qr-code" aria-hidden="true"></span> Pair Devices</NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="device-configuration">
                <span class="bi bi-gear" aria-hidden="true"></span> Device Configuration
            </NavLink>
        </div>

        @if (AuthState.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="nexus-settings">
                    <span class="bi bi-cloud-arrow-up" aria-hidden="true"></span> Nexus Settings
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="scouting">
                <span class="bi bi-clipboard-check"
                      aria-hidden="true"></span> Scouting
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="submissions">
                <span class="bi bi-database"
                      aria-hidden="true"></span> Submissions
            </NavLink>
        </div>

        @if (AuthState.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="appearance">Appearance Editor</NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="allianceselection">Alliance Selection</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="allianceplan">Alliance Plan</NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    protected override void OnInitialized()
    {
        AuthState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
    }

    private void Logout()
    {
        AuthState.Logout();
        Navigation.NavigateTo("/login");
    }
}















