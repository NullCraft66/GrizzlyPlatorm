<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GrizzlyScout"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/homeSeason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026 REBUILT"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/viewSubmittedFormsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Submitted Forms"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/newPitFormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fill Out New Pit Form"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/newMatchFormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fill Out New Match Form"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/editSubmittedFormsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View / Edit Submitted Forms"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/teamsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teams" />

            <Button
                android:id="@+id/currentEventButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Current Event" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

